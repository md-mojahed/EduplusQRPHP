{
    "name": "mojahed/eduplusqr",
    "description": "Fast QR code and barcode generation for PHP 7.4+ (PNG, SVG, PDF) using the standalone EduplusQR binary: 15 code types, logos, styles, Wi-Fi/vCard/payment payloads, batches, ZIP and PDF label sheets. No PHP extensions needed.",
    "type": "library",
    "version": "1.0.2",
    "license": "MIT",
    "keywords": ["qr", "qrcode", "qr-code", "barcode", "code128", "ean13", "upc", "datamatrix", "pdf417", "aztec", "wifi", "vcard", "label"],
    "authors": [
        {
            "name": "Md Mojahedul Islam",
            "email": "dev.mojahedul@gmail.com",
            "homepage": "https://md-mojahed.github.io"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Mojahed\\EduplusQR\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mojahed\\EduplusQR\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
